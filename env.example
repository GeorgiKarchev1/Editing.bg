# SMTP настройки за Vercel
# Копирайте този файл като .env.local за локално развитие

# Gmail SMTP (препоръчителен)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Resend.com (алтернатива)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your-resend-api-key

# Brevo (Sendinblue) - безплатно до 300 имейла/ден
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-email@domain.com
# SMTP_PASS=your-brevo-smtp-key

# Други настройки
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
